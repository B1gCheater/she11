# ===== Deployment secrets — never commit =====
# The real relay keypair and live/deployed configs stay on this machine.
config/server.key
config/server.crt
test/live_commander.toml
*.key
!config/server_test.key

# ===== Build-time injected deployment values =====
# Generated by builder-tools/genconfig.py; carries real relay endpoints,
# fleet magic and the pinned production certificate. Use the .example instead.
src/shared/gen/config_gen.go

# ===== Build outputs =====
bin/
*.exe
*.exe~
*.pdb
*.obj
*.dll
*.so

# ===== Local test artifacts, probes and acceptance snapshots =====
# Useful locally, rebuilt on demand; never part of the release tree.
test/
__pycache__/
*.pyc

# ===== Workspace memory (local only) =====
.workbuddy/

# ===== Editor / OS noise =====
.vscode/
.idea/
Thumbs.db
.DS_Store
*.swp
